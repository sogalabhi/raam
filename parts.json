        "description": "Demand is at least as random as pure chance, and deliveries slip — imports by about a quarter of the lead time, domestic parts by a tenth."
      },
      "stress": {
        "label": "Stress",
        "varianceFloor": true,
        "leadTimeCV": {
          "Domestic": 0.2,
          "Import": 0.4
        },
        "description": "Same random demand, and deliveries slip badly — imports by 40% of the lead time, domestic parts by 20%."
      },
      "formula": "sigmaLTD = sqrt(L * var_d + d^2 * (leadTimeCV * L)^2), var_d = max((CV*d)^2, d) if varianceFloor else (CV*d)^2; MIN = ceil(z * sigmaLTD); ROP = ceil(d*L + z*sigmaLTD). With best, this is exactly the Excel's z*sigma*sqrt(L)."
    },
    "oldWay": {
      "reviewDays": 30,
      "coverDays": 60,
      "basis": "usage in the last 30 days",
      "description": "Every 30 days, order up to 60 days of cover based on last month's usage. No safety stock; ignores lead time and criticality. Same 60-day buffer as naiveBufferDays, so the capital baseline and the simulation baseline are one rule."
    },
    "metrics": {
      "emergencyRate": "emergency orders / (regular orders + emergency orders). One emergency order per part per day that on-hand cannot cover. Matches the casebook wording '22% of orders become emergency'.",
      "jobsWaiting": "days with a shortfall / days with demand, per part. Cannot be improved by ordering more often, so it is shown next to emergencyRate.",
      "projectedStockoutRate": "Excel's 11.4%: sum(D/EOQ * (1 - SL)) / sum(D/EOQ), the share of reorder cycles expected to run out. A design target, not a measured result."
    }
  },
